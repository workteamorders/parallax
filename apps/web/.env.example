NEXT_PUBLIC_BUILDER_ADDRESS=
# Live-only mode (devnet stage, no database/worker/Railway): the web app fetches Jupiter and Velocity itself.
# PARALLAX_LIVE_MODE=1
# DEVNET_TRADING_ENABLED=true
# NEXT_PUBLIC_FEED_URL=off   (build time; disables the WebSocket, page refreshes every 30 s)
