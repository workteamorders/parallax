# Reference only. Supply configuration through the process environment.
# Local development works without any environment file.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:55432/REPLACE_DATABASE
REDIS_URL=redis://127.0.0.1:56379
WEB_ORIGIN=http://127.0.0.1:3100
SOLANA_NETWORK=devnet
BUILDER_FEE_TENTHS_BP=20
BLOCKED_COUNTRIES=US,CU,IR,KP,SY
WORKER_INTERVAL_MS=120000
SIGNAL_WINDOW_MINUTES=60
SIGNAL_Z_THRESHOLD=2
SIGNAL_FOLLOW_THRESHOLD=0.5
SIGNAL_MIN_COUNT=30
# Execution and Telegram are disabled in code, not configurable trading flags.
# Never supply a private key or seed phrase.
